#ifndef TAC
#define TAC(name)
#endif

#ifndef TAC_KWD
#define TAC_KWD(kwd)
#endif

#ifndef TAC_DTYPE
#define TAC_DTYPE(kwd)
#endif

#ifndef OP_MAP
#define OP_MAP(op)
#endif

#ifndef OP_MAP_COMPOUND
#define OP_MAP_COMPOUND(op_org, op_first)
#endif

#ifndef TAC_TOKEN_MAP
#define TAC_TOKEN_MAP(token, tac)
#endif

TAC(TAC_NOP)
TAC(TAC_ADD)
TAC(TAC_SUB)
TAC(TAC_MUL)
TAC(TAC_DIV)
TAC(TAC_MOD)
TAC(TAC_AND)
TAC(TAC_OR)
TAC(TAC_BIT_AND)
TAC(TAC_BIT_OR)
TAC(TAC_BIT_XOR)
TAC(TAC_LSHIFT)
TAC(TAC_RSHIFT)
TAC(TAC_CMP_EQ)
TAC(TAC_CMP_NEQ)
TAC(TAC_CMP_LT)
TAC(TAC_CMP_LTE)
TAC(TAC_CMP_GT)
TAC(TAC_CMP_GTE)
TAC(TAC_COPY)
TAC(TAC_CAST)
TAC(TAC_LABEL)
TAC(TAC_JMP)
TAC(TAC_JMF)
TAC(TAC_NOT)   
TAC(TAC_NEG)      
TAC(TAC_ADDR)      // &addr
TAC(TAC_BIT_NOT)
TAC(TAC_PARAM)
TAC(TAC_CALL)


TAC_KWD(KWD_IF)
TAC_KWD(KWD_WHILE)

TAC_DTYPE(KWD_INT)
TAC_DTYPE(KWD_CHR)


OP_MAP(OP_EQUALS)
OP_MAP(OP_PLUS_PLUS)
OP_MAP(OP_MINUS_MINUS)
OP_MAP(OP_PLUS_PLUS_POST)
OP_MAP(OP_MINUS_MINUS_POST)

OP_MAP_COMPOUND(OP_PLUS_EQUALS, OP_PLUS)
OP_MAP_COMPOUND(OP_MINUS_EQUALS, OP_MINUS)
OP_MAP_COMPOUND(OP_MULTIPLY_EQUALS, OP_MULTIPLY)
OP_MAP_COMPOUND(OP_DIVIDE_EQUALS, OP_DIVIDE)


TAC_TOKEN_MAP(OP_PLUS, TAC_ADD)
TAC_TOKEN_MAP(OP_MINUS, TAC_SUB)
TAC_TOKEN_MAP(OP_MULTIPLY, TAC_MUL)
TAC_TOKEN_MAP(OP_DIVIDE, TAC_DIV)
TAC_TOKEN_MAP(OP_MODULO, TAC_MOD)

TAC_TOKEN_MAP(OP_EQUALS_EQUALS, TAC_CMP_EQ)
TAC_TOKEN_MAP(OP_NOT_EQUALS, TAC_CMP_NEQ)
TAC_TOKEN_MAP(OP_LESSER, TAC_CMP_LT)
TAC_TOKEN_MAP(OP_LESSER_EQUALS, TAC_CMP_LTE)
TAC_TOKEN_MAP(OP_GREATER, TAC_CMP_GT)
TAC_TOKEN_MAP(OP_GREATER_EQUALS, TAC_CMP_GTE)

TAC_TOKEN_MAP(OP_AND, TAC_AND)
TAC_TOKEN_MAP(OP_OR, TAC_OR)

TAC_TOKEN_MAP(OP_BITWISE_AND, TAC_BIT_AND)
TAC_TOKEN_MAP(OP_BITWISE_OR, TAC_BIT_OR)
TAC_TOKEN_MAP(OP_BITWISE_XOR, TAC_BIT_XOR)
TAC_TOKEN_MAP(OP_LSHIFT, TAC_LSHIFT)
TAC_TOKEN_MAP(OP_RSHIFT, TAC_RSHIFT)

TAC_TOKEN_MAP(OP_NOT, TAC_NOT)
TAC_TOKEN_MAP(OP_UN_MINUS, TAC_NEG)
TAC_TOKEN_MAP(OP_UN_BITWISE_AND, TAC_ADDR)
TAC_TOKEN_MAP(OP_BITWISE_NOT, TAC_BIT_NOT)


#undef TAC
#undef TAC_KWD
#undef TAC_DTYPE
#undef OP_MAP
#undef OP_MAP_COMPOUND
#undef TAC_TOKEN_MAP
