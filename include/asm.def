#ifndef ASM_MAP
#define ASM_MAP(tac, asm)
#endif

ASM_MAP(TAC_ADD, "add")
ASM_MAP(TAC_SUB, "sub")
ASM_MAP(TAC_MUL, "imul")
ASM_MAP(TAC_AND, "and")
ASM_MAP(TAC_OR,  "or")
ASM_MAP(TAC_BIT_AND, "and")
ASM_MAP(TAC_BIT_OR,  "or")
ASM_MAP(TAC_BIT_XOR, "xor")


#ifndef CUSTOM_GEN
#define CUSTOM_GEN(op)
#endif

CUSTOM_GEN(TAC_COPY)
CUSTOM_GEN(TAC_CAST)
CUSTOM_GEN(TAC_DIV)
CUSTOM_GEN(TAC_MOD)
CUSTOM_GEN(TAC_LSHIFT) 
CUSTOM_GEN(TAC_RSHIFT)
CUSTOM_GEN(TAC_LABEL)
CUSTOM_GEN(TAC_JMP)
CUSTOM_GEN(TAC_JMF)

CUSTOM_GEN(TAC_CMP_EQ)
CUSTOM_GEN(TAC_CMP_NEQ)
CUSTOM_GEN(TAC_CMP_LT)
CUSTOM_GEN(TAC_CMP_GT)
CUSTOM_GEN(TAC_CMP_LTE)
CUSTOM_GEN(TAC_CMP_GTE)

CUSTOM_GEN(TAC_NOT)
CUSTOM_GEN(TAC_NEG)
CUSTOM_GEN(TAC_BIT_NOT)
CUSTOM_GEN(TAC_ADDR)

CUSTOM_GEN(TAC_PARAM)
CUSTOM_GEN(TAC_CALL)

#undef ASM_MAP
#undef CUSTOM_GEN
