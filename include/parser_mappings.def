PREC(PREC_ERR)
PREC(PREC_COMMA)
PREC(PREC_ASS)
PREC(PREC_EQ)
PREC(PREC_REL)
PREC(PREC_ADD)
PREC(PREC_MULT)
PREC(PREC_UNARY)

MAP(OP_NOT, PREC_UNARY, ASS_RIGHT)
MAP(OP_UN_PLUS, PREC_UNARY, ASS_RIGHT)
MAP(OP_UN_MINUS, PREC_UNARY, ASS_RIGHT)
MAP(OP_PLUS_PLUS, PREC_UNARY, ASS_RIGHT)
MAP(OP_MINUS_MINUS, PREC_UNARY, ASS_RIGHT)
MAP(OP_UN_BITWISE_AND, PREC_UNARY, ASS_RIGHT)

MAP(OP_PLUS_PLUS_POST, PREC_UNARY, ASS_LEFT)
MAP(OP_MINUS_MINUS_POST, PREC_UNARY, ASS_LEFT)

MAP(OP_MULTIPLY, PREC_MULT, ASS_LEFT)
MAP(OP_DIVIDE, PREC_MULT, ASS_LEFT)
MAP(OP_MODULO, PREC_MULT, ASS_LEFT)

MAP(OP_PLUS, PREC_ADD, ASS_LEFT)
MAP(OP_MINUS, PREC_ADD, ASS_LEFT)

MAP(OP_LESSER, PREC_REL, ASS_LEFT)
MAP(OP_GREATER, PREC_REL, ASS_LEFT)
MAP(OP_LESSER_EQUALS, PREC_REL, ASS_LEFT)
MAP(OP_GREATER_EQUALS, PREC_REL, ASS_LEFT)

MAP(OP_NOT_EQUALS, PREC_EQ, ASS_LEFT)
MAP(OP_EQUALS_EQUALS, PREC_EQ, ASS_LEFT)

MAP(OP_PLUS_EQUALS, PREC_ASS, ASS_RIGHT)
MAP(OP_MINUS_EQUALS, PREC_ASS, ASS_RIGHT)
MAP(OP_DIVIDE_EQUALS, PREC_ASS, ASS_RIGHT)
MAP(OP_MULTIPLY_EQUALS, PREC_ASS, ASS_RIGHT)
MAP(OP_EQUALS, PREC_ASS, ASS_RIGHT)

MAP(OP_COMMA, PREC_COMMA, ASS_LEFT)


/**
 *Unassigned
 */
MAP(OP_AND, PREC_ERR, ASS_LEFT)
MAP(OP_OR, PREC_ERR, ASS_LEFT)

MAP(OP_BITWISE_AND, PREC_ERR, ASS_LEFT)
MAP(OP_BITWISE_OR, PREC_ERR, ASS_LEFT)
MAP(OP_BITWISE_XOR, PREC_ERR, ASS_LEFT)
MAP(OP_BITWISE_NOT, PREC_ERR, ASS_RIGHT)

MAP(OP_LSHIFT, PREC_ERR, ASS_LEFT)
MAP(OP_RSHIFT, PREC_ERR, ASS_LEFT)

MAP(OP_DOT, PREC_ERR, ASS_LEFT)
MAP(OP_ARROW, PREC_ERR, ASS_LEFT)



ST(KWD_IF)
ST(KWD_WHILE)
ST(KWD_FOR)
