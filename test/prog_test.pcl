# 1. Global Scope Declarations
int global_x = 100;
char global_c;

{
    # 2. Scope Shadowing
    # This should register in the local block table, not throw a redeclaration error.
    int global_x = 5; 

    # 3. Standard Initialization
    int a = 10;
    char b = 'b';

    # 4. Arithmetic Type Promotion (PROM_R/PROM_L test)
    # 'b' should trigger a CONV node injection before the addition.
    int sum = a + b; 

    # 5. Relational Operator Test
    # Result should correctly evaluate to KWD_INT, not KWD_CHR.
    int is_match = (b == 'c'); 

    # 6. Compound Assignment & Unary Promotion
    # Unary ! on a char should promote it to int.
    sum += 1;
    is_match = !b; 
}
